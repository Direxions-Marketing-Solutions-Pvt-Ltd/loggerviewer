# Database
DB_PATH=data/database.sqlite

# Auth
AUTH_SECRET=replace_with_a_secure_random_token
APP_TITLE="Logger View"

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls # options: ssl, tls, starttls, plain
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Logger View"

# Defaults
DEFAULT_AUTH_TYPE=password # options: password, otp
